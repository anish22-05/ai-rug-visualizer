# Base URL of the analysis API. Leave empty in development (Vite proxies /api and /static).
# Set it for production builds, e.g. https://<your-space>.hf.space
VITE_API_BASE_URL=

# Dev only: where the Vite proxy forwards /api and /static (default http://127.0.0.1:8000).
VITE_DEV_BACKEND=http://127.0.0.1:8000
