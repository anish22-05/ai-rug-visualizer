# Copy to backend/.env for local overrides. The analysis API needs no secrets; ADMIN_TOKEN
# is the only one, and only if you enable the store-owner dashboard.

# Browser origins allowed to call the API (comma-separated). Add your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limit (MB) and decoded pixel cap (decompression-bomb guard).
MAX_UPLOAD_MB=15
MAX_PIXELS=40000000

# Long edge (px) the CV pipeline works at.
WORK_LONG_EDGE=1024

# Hugging Face model ids.
# SEG_MODEL: EoMT-L (default, sharper occluders) or nvidia/segformer-b2-finetuned-ade-512-512 (faster).
SEG_MODEL=tue-mps/ade20k_semantic_eomt_large_512
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Metric-Indoor-Small-hf

# auto | cpu | cuda
DEVICE=auto

# Requests per client for POST /analyze.
RATE_LIMIT=30/minute

# Store-owner dashboard (/admin). Leave empty to disable the owner API entirely.
# Use a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# Where owner edits are stored (must be writable; use a persistent volume in production).
# Empty = backend/var/catalog.json and backend/var/uploads.
CATALOG_PATH=
UPLOAD_DIR=
